# =================================================================
#  NOVATERRA — Environment variables
#  Copy this file to .env (local dev) and paste the same values into
#  Netlify → Site settings → Environment variables (production).
# =================================================================

# ── Database (Supabase Postgres) ─────────────────────────────────
# Pooled connection used at runtime (Netlify Functions, dev server).
# Format: Settings → Database → Connection string → "Transaction pooler"
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct (non-pooled) connection used by `prisma db push` / `prisma migrate`.
# Format: Settings → Database → Connection string → "Direct connection"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ── NextAuth (admin login) ───────────────────────────────────────
# In production, set NEXTAUTH_URL to your real domain (https://novaterra.netlify.app)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# ── Public site origin (used by share links + QR codes) ──────────
# In production, set this to your live domain — phones must be able to reach it.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Seed admin (used by prisma/seed.ts) ──────────────────────────
ADMIN_EMAIL="admin@novaterra.com"
ADMIN_PASSWORD="novaterra2026"
